# FLUXFIRE local environment template
# Copy to .env.local only for local development. Do not commit real secrets.

# Lovable Cloud public browser configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Server-side copies of the public backend configuration (used during SSR)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Server-only privileged key. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=""

# Only needed to apply drizzle/migrations against your own Postgres database
LOVABLE_DB_MIGRATION_URL=""

# Server-only Lovable AI Gateway access
# Set through Lovable project secrets/runtime settings, not in committed files.
LOVABLE_API_KEY=""

# Optional scheduled-job protection if cron endpoints are added later.
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""